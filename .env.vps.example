# Public values embedded into the Academy browser build.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only values injected into the Academy function container at runtime.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_USERNAME=
# Lowercase SHA-256 digest of the admin password.
ADMIN_PASSWORD_HASH=
# Generate at least 32 random bytes. Never commit the actual value.
ADMIN_SESSION_SECRET=
